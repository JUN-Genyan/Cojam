{
  "id": "antigravity",
  "label": "Antigravity",
  "letter": "A",
  "color": "#34a853",
  "driver": "cli",
  "bin": [
    "agy",
    "%USERPROFILE%\\.gemini\\bin\\agy.exe"
  ],
  "detect": [
    "%USERPROFILE%\\.gemini\\bin\\agy.exe",
    "%LOCALAPPDATA%\\Programs\\antigravity\\resources\\bin\\language_server.exe",
    "%LOCALAPPDATA%\\Programs\\Antigravity\\resources\\bin\\language_server.exe"
  ],
  "shortcuts": ["Antigravity"],
  "note": "本机 CLI（Antigravity 自带的 agy）：会议室直接叫它，非交互跑一轮。读模式用 --mode plan（只读），干活模式用 --mode accept-edits --dangerously-skip-permissions。会话 id 取自 JSON 输出的 conversation_id，续接用 --conversation。",
  "args": {
    "base": [],
    "read": ["--mode", "plan"],
    "work": ["--mode", "accept-edits", "--dangerously-skip-permissions"],
    "new": ["-p", "{prompt}", "--output-format", "json"],
    "resume": ["--conversation", "{session}", "-p", "{prompt}", "--output-format", "json"]
  },
  "prompt": "arg",
  "images": [],
  "parse": {
    "type": "json",
    "text": "response",
    "session": "conversation_id"
  },
  "context": "delta",
  "models": [],
  "efforts": [],
  "default": [
    "",
    ""
  ],
  "caps": {
    "handoff": true
  },
  "handoff": "agy --conversation {session}"
}
