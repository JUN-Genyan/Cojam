    {
      "id": "copilot",
      "label": "GitHub Copilot / VS Code",
      "color": "#24292f",
      "cli": {
        "driver": "cli",
        "bin": ["copilot"],
        "paths": ["%APPDATA%\\npm\\copilot.cmd"],
        "args": {
          "work": ["--allow-all-tools"],
          "new": ["-p", "{prompt}"]
        },
        "parse": {"type": "text"},
        "context": "full",
        "verified": false
      },
      "desktop": {
        "detect": [
          "%LOCALAPPDATA%\\Programs\\Microsoft VS Code\\Code.exe",
          "%ProgramFiles%\\Microsoft VS Code\\Code.exe"
