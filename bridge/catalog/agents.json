{
  "agents": [
    {
      "id": "claude",
      "label": "Claude Code / Desktop",
      "color": "#d97757",
      "cli": {
        "driver": "claude",
        "bin": ["claude"],
        "paths": [
          "%APPDATA%\\npm\\claude.cmd",
          "%USERPROFILE%\\.local\\bin\\claude.exe",
          "%LOCALAPPDATA%\\AnthropicClaude\\claude.exe"
        ],
        "verified": true
      },
      "desktop": {
        "detect": [
          "%LOCALAPPDATA%\\AnthropicClaude\\Claude.exe",
          "%LOCALAPPDATA%\\Programs\\Claude\\Claude.exe"
        ],
        "uninstall": ["Claude"]
      },
      "mcp": {
        "id": "claude",
        "label": "Claude Code",
        "kind": "claude",
        "bin": ["claude"],
        "restart": "重开 claude（/mcp 里能看到 ai-bridge）"
      },
      "mcp_desktop": {
        "id": "claude-desktop",
        "label": "Claude Desktop",
        "kind": "json-stdio",
        "path": "%APPDATA%\\Claude\\claude_desktop_config.json",
        "detect": [
          "%LOCALAPPDATA%\\AnthropicClaude\\Claude.exe",
          "%LOCALAPPDATA%\\Programs\\Claude\\Claude.exe"
        ],
        "restart": "完全退出并重开 Claude Desktop"
      },
      "install_hint": "https://docs.claude.com/en/docs/claude-code"
    },
    {
      "id": "codex",
      "label": "OpenAI Codex",
      "color": "#10a37f",
      "cli": {
        "driver": "codex",
        "bin": ["codex"],
        "paths": [
          "%APPDATA%\\npm\\codex.cmd",
          "%LOCALAPPDATA%\\Programs\\Codex\\resources\\bin\\codex.exe",
          "%LOCALAPPDATA%\\Programs\\codex\\resources\\bin\\codex.exe"
        ],
        "verified": true
      },
      "desktop": {
        "detect": [
          "%LOCALAPPDATA%\\Programs\\Codex\\Codex.exe",
          "%LOCALAPPDATA%\\Programs\\codex\\Codex.exe"
        ],
        "uninstall": ["Codex"]
      },
      "mcp": {
        "id": "codex",
        "label": "Codex",
        "kind": "toml",
        "bin": ["codex"],
        "path": "~/.codex/config.toml",
        "restart": "重开 codex"
      },
      "install_hint": "https://github.com/openai/codex"
    },
    {
      "id": "antigravity",
      "label": "Google Antigravity",
      "color": "#34a853",
      "cli": {
        "driver": "cli",
        "bin": ["agy"],
        "paths": [
          "%LOCALAPPDATA%\\Programs\\antigravity\\bin\\agy.cmd",
          "%LOCALAPPDATA%\\Programs\\Antigravity\\bin\\agy.cmd",
          "%USERPROFILE%\\.local\\bin\\agy.exe"
        ],
        "args": {
          "new": ["-p", "{prompt}"]
        },
        "parse": {"type": "text"},
        "context": "full",
        "verified": false
      },
      "desktop": {
        "detect": [
          "%LOCALAPPDATA%\\Programs\\antigravity\\resources\\bin\\language_server.exe",
          "%LOCALAPPDATA%\\Programs\\Antigravity\\resources\\bin\\language_server.exe",
          "%LOCALAPPDATA%\\Programs\\Antigravity\\Antigravity.exe"
        ],
        "uninstall": ["Antigravity"]
      },
      "mcp": {
        "id": "antigravity",
        "label": "Google Antigravity",
        "kind": "json",
        "path": "~/.gemini/config/mcp_config.json",
        "detect": [
          "%LOCALAPPDATA%\\Programs\\antigravity\\resources\\bin\\language_server.exe",
          "%LOCALAPPDATA%\\Programs\\Antigravity\\resources\\bin\\language_server.exe"
        ],
        "restart": "重启 Antigravity（完全退出再开）"
      },
      "install_hint": "https://antigravity.google/docs/cli/reference"
    },
    {
      "id": "cursor",
